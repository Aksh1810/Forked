# Build output
node_modules/
dist/
.next/
*.tsbuildinfo
coverage/

# Next.js autogenerated (regenerated by dev/build; not meant to be edited)
packages/web/next-env.d.ts

# Stockfish wasm, copied from node_modules by the web predev/prebuild script
packages/web/public/engine/

# CDK
cdk.out/
.cdk.staging/

# Secrets and local config. .env.example stays tracked if one is ever added.
.env
.env.*
!.env.example

# Editors and OS
.DS_Store
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*

# Agent tooling scratch
.claude/settings.local.json
.superpowers/

# Installed agent skills (managed by skills-lock.json — run the installer to
# restore). The lockfile is tracked; the installed content and its symlinks
# are not. Hand-authored skills under productivity/ stay tracked.
.agents/
.claude/skills/*
!.claude/skills/productivity/

# Private ops log (account details, deploy-day evidence); the rest of docs/
# is published and linked from the README.
docs/migration-plan.md

# DynamoDB Local (jvm-stack) artifact
dynamodb-local-metadata.json

# Stockfish engine binaries (downloaded at build time, never vendored)
Copying.txt
stockfish-18-lite*.js
stockfish*.wasm
*.wasm
CLAUDE.md